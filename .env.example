# --- Telegram -------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Who can use the bot. An update is accepted when its user OR its chat is listed.
# Comma-separated. Send /id to the bot to discover your ids.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# --- Storage --------------------------------------------------------------
# Folder holding homegram.db (the Docker image uses /data, mounted as a volume).
# Used for every backend: it also stores topic bindings and per-chat state.
# DATA_DIR=/data
# Docker only: user/group the bot runs as. DATA_DIR is chown'ed to them at startup.
# PUID=1000
# PGID=1000
# LOG_LEVEL=INFO

# --- Shopping list --------------------------------------------------------
# sqlite (default, one list per chat) | homeassistant (uses a Home Assistant to-do entity)
SHOPPING_BACKEND=sqlite

# --- Home Assistant (optional) -------------------------------------------
# Base URL of Home Assistant, as seen from the HomeGram container:
#   - HA on the same host (docker compose): http://host.docker.internal:8123
#   - HA in the same compose network:       http://homeassistant:8123
#   - HA elsewhere on the LAN:              http://192.168.1.10:8123
# HA_URL=
# Long-lived access token: HA profile -> Security -> Long-lived access tokens
# HA_TOKEN=
# HA_SHOPPING_ENTITY=todo.shopping_list
# Price tracker (/tracker, /tracker_aggiungi, /tracker_rimuovi, /tracker_notifiche): enabled automatically with HA_URL + HA_TOKEN.
# The token must belong to an administrator. Notifications go to the topic bound with /bind tracker.
# Old HA automation whose muted products are imported once:
# HA_TRACKER_AUTOMATION=tracker_notifica

# Scenes (/scene): empty = every scene and every script without input fields
# HA_SCENES=script.esco,script.entro,scene.cinema

# Robot vacuum notifications (/bind pulizie). Battery/error/parts are found on its device if empty.
# HA_VACUUM=vacuum.robot
# HA_VACUUM_BATTERY=
# HA_VACUUM_ERROR=
# HA_VACUUM_PARTS=
# VACUUM_PARTS_THRESHOLD=10

# Waste collection (/bidoni, /bind bidoni): waste_collection_schedule sensors (empty = all)
# HA_WASTE_SENSORS=
# WASTE_REMINDER_TIME=19:30
# WASTE_REPEAT_TIME=21:30

# Energy (/energia, /bind energia): set the sensors you have, the others are left out.
# ENERGY_SOLAR_POWER=
# ENERGY_LOAD_POWER=
# ENERGY_GRID_POWER=          # > 0 import, < 0 export
# ENERGY_BATTERY_POWER=       # > 0 charging
# ENERGY_BATTERY_SOC=
# ENERGY_SOLAR_TODAY=
# ENERGY_LOAD_TODAY=
# ENERGY_IMPORT_TODAY=
# ENERGY_EXPORT_TODAY=
# ENERGY_FORECAST_TODAY=
# ENERGY_FORECAST_TOMORROW=
# ENERGY_PEAK_TOMORROW=
# ENERGY_SURPLUS_KW=1
# ENERGY_REPORT_TIME=21:00

# --- Docker compose -------------------------------------------------------
# Image tag to run (e.g. 0.1.0-alpha.1). Defaults to latest.
# HOMEGRAM_VERSION=latest
